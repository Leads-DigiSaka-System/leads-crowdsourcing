generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pledge {
  id              String             @id @default(cuid())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  userId          String
  projectId       String
  amount          Int
  status          String
  paymongoId      String?            @unique
  paymongoData    Json?
  solanaSignature String?
  allocations     BudgetAllocation[]
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([solanaSignature])
  @@map("pledges")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  colorHex  String    @default("#e0f2fe")
  textColor TextColor @default(black)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  icon      String?
  projects  Project[]

  @@map("categories")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String                  @unique
  username               String                  @unique
  password               String?
  role                   String                  @default("user")
  emailVerified          DateTime?
  image                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  accounts               Account[]
  sessions               Session[]
  commentUpvotes         CommentUpvote[]
  comments               Comment[]
  meetingRequests        MeetingRequest[]
  sentMessages           Message[]
  pledges                Pledge[]
  drafts                 ProjectDraft[]
  createdProjects        Project[]               @relation("ProjectAddedBy")
  researcherApplications ResearcherApplication[]
  companyLogo            String?

  passwordResets PasswordReset[]
}

model PasswordReset {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_verification_codes")
}

model EmailVerificationSession {
  token     String   @id
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_verification_sessions")
}

model OneTimeLoginToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("one_time_login_tokens")
}

model Project {
  id                      String                  @id @default(cuid())
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  addedBy                 String
  title                   String
  tagline                 String                  @default("")
  authors                 String?
  image                   String?
  imageAlt                String?
  pledged                 Int                     @default(0)
  goal                    Int
  currency                String                  @default("PHP")
  daysLeft                Int
  tags                    String[]
  featuredHero            Boolean                 @default(false)
  show                    Boolean                 @default(true)
  location                String?
  overview                String
  methods                 String
  labNotes                String
  discussion              String
  contextAnswer           String
  significanceAnswer      String
  goalsAnswer             String
  teamDescription         String
  budgetDescription       String
  timelineDescription     String
  categoryId              String?
  archived                Boolean                 @default(false)
  timelineDurationMonths  Int?
  recommendationRank      Int?                    @unique
  isCompleted             Boolean                 @default(false)
  fromApplication         Boolean                 @default(false)
  slug                    String?                 @unique
  budgetItems             BudgetItem[]
  comments                Comment[]
  meetingRequests         MeetingRequest[]
  pledges                 Pledge[]
  addedByUser             User                    @relation("ProjectAddedBy", fields: [addedBy], references: [id], onDelete: Cascade)
  category                Category?               @relation(fields: [categoryId], references: [id])
  createdFromApplications ResearcherApplication[] @relation("CreatedFromApplication")
  revisionApplications    ResearcherApplication[] @relation("ApplicationTargetProject")
  teamMembers             TeamMember[]
  timelineEvents          TimelineEvent[]

  @@map("projects")
}

model TeamMember {
  id             Int      @id @default(autoincrement())
  projectId      String
  name           String?
  role           String
  bio            String
  image          String?
  imageAlt       String?
  email          String?
  linkedin       String?
  twitter        String?
  expertise      String[]
  responsibility String?
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("team_members")
}

model BudgetItem {
  id          Int                @id @default(autoincrement())
  projectId   String
  name        String
  description String?
  value       Int
  allocated   Int                @default(0)
  position    Int                @default(0)
  allocations BudgetAllocation[]
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("budget_items")
}

model BudgetAllocation {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  pledgeId     String
  budgetItemId Int
  amount       Int
  budgetItem   BudgetItem @relation(fields: [budgetItemId], references: [id])
  pledge       Pledge     @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([pledgeId])
  @@index([budgetItemId])
  @@map("budget_allocations")
}

model TimelineEvent {
  id        Int     @id @default(autoincrement())
  projectId String
  date      String
  title     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("timeline_events")
}

model ProjectDraft {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  addedBy   String
  data      Json
  user      User     @relation(fields: [addedBy], references: [id], onDelete: Cascade)

  @@index([addedBy])
  @@map("project_drafts")
}

model ResearcherApplication {
  id                     String                      @id @default(cuid())
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  userId                 String
  status                 ResearcherApplicationStatus @default(PENDING)
  approvedAt             DateTime?
  approvedBy             String?
  targetProjectId        String?
  title                  String
  authors                String?
  image                  String?
  imageAlt               String?
  currency               String                      @default("PHP")
  daysLeft               Int
  tags                   String[]
  categoryId             String?
  location               String?
  overview               String
  methods                String
  labNotes               String?
  discussion             String?
  contextAnswer          String
  significanceAnswer     String
  goalsAnswer            String
  teamDescription        String
  budgetDescription      String
  timelineDescription    String
  timelineDurationMonths Int?
  teamMembers            Json
  budgetItems            Json
  timelineEvents         Json
  createdProjectId       String?
  createdProject         Project?                    @relation("CreatedFromApplication", fields: [createdProjectId], references: [id])
  targetProject          Project?                    @relation("ApplicationTargetProject", fields: [targetProjectId], references: [id])
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([targetProjectId])
  @@map("researcher_applications")
}

model MeetingRequest {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  userId        String
  projectId     String
  preferredDate String
  preferredTime String
  reason        String
  status        MeetingRequestStatus @default(PENDING)
  meetingLink   String?
  scheduledDate DateTime?
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([userId])
  @@index([status])
  @@map("meeting_requests")
}

model Message {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())
  meetingRequestId String
  senderId         String
  content          String
  isAdminMessage   Boolean        @default(false)
  meetingRequest   MeetingRequest @relation(fields: [meetingRequestId], references: [id], onDelete: Cascade)
  sender           User           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([meetingRequestId])
  @@index([senderId])
  @@map("messages")
}

model Comment {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  projectId   String
  userId      String
  parentId    String?
  content     String
  isAnonymous Boolean         @default(false)
  upvotes     Int             @default(0)
  isHidden    Boolean         @default(false)
  isEdited    Boolean         @default(false)
  upvoters    CommentUpvote[]
  parent      Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]       @relation("CommentReplies")
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@map("comments")
}

model CommentUpvote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  commentId String
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_upvotes")
}

enum ResearcherApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_PENDING
}

enum TextColor {
  black
  white
}

enum MeetingRequestStatus {
  PENDING
  READ
  SCHEDULED
  COMPLETED
  REJECTED
}
